# Live Supabase. Leave all three empty to run the local mock desk.
# Never commit real values. The service role key stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used to sign the local mock session cookie.
# Production on db357.com should set a long random value.
HUB_SESSION_SECRET=

# Sub-apps that copy lib/appGuard.ts set this so a denial returns to the hub.
# Leave unset inside the hub itself.
# NEXT_PUBLIC_HUB_ORIGIN=https://db357.com
