# Live Supabase. Leave the URL and anon key empty to run the local mock desk.
# Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Lockout counters, audit inserts, and provisioning.
# Leave empty until it is set in the host environment. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used to sign the local mock session cookie.
# Production on db357.com should set a long random value.
HUB_SESSION_SECRET=

# Sub-apps that copy lib/appGuard.ts set this so a denial returns to the hub.
# Leave unset inside the hub itself.
# NEXT_PUBLIC_HUB_ORIGIN=https://db357.com

# Server only. Shared with Land Desk. Signs the 60-second Open token when can_access_land is true.
# At least 32 characters. Set the same value on 168.db357.com. Never commit a real value.
LAND_HANDOFF_SECRET=

# Optional. Defaults to https://168.db357.com. Any other host is ignored, except localhost for a local Land app.
# LAND_DESK_URL=https://168.db357.com

# Server only. Shared with DM-CK, not with Land. Signs the 60-second Open token when can_access_dmck is true.
# At least 32 characters. Set the same value on the DM-CK app. Do not reuse LAND_HANDOFF_SECRET.
DMCK_HANDOFF_SECRET=

# Optional. Defaults to https://spinlytics-db357.vercel.app, the DM-CK app that is actually running.
# https://db357.com/dmck is this hub. Set the path below only after DM-CK itself serves it.
# Any other host is ignored, except localhost for a local DM-CK app.
# DMCK_DESK_URL=https://spinlytics-db357.vercel.app
# DMCK_DESK_URL=https://www.db357.com/dmck
